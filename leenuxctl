# ------------------------------------------------------------
# Main
# ------------------------------------------------------------

need_root

case "${1:-}" in

    status)
        status
        ;;

    doctor)
        doctor
        ;;

    start)
        start_hotspot
        ;;

    stop)
        stop_hotspot
        ;;

    restart)
        restart_hotspot
        ;;

    setup)
        shift
        setup_hotspot "$@"
        ;;

    mode)
        case "${2:-}" in
            router)
                mode_router
                ;;
            lan-only)
                mode_lan_only
                ;;
            disabled)
                mode_disabled
                ;;
            *)
                die "usage: leenuxctl mode {router|lan-only|disabled}"
                ;;
        esac
        ;;

    client)
        case "${2:-}" in

            list)
                ensure_policy
                client_list
                ;;

            status)
                [[ -n "${3:-}" ]] ||
                    die "usage: leenuxctl client status <MAC|IP|hostname>"
                ensure_policy
                client_status "$3"
                ;;

            block)
                [[ -n "${3:-}" ]] ||
                    die "usage: leenuxctl client block <MAC|IP|hostname>"
                ensure_policy
                block_client "$3"
                ;;

            unblock)
                [[ -n "${3:-}" ]] ||
                    die "usage: leenuxctl client unblock <MAC|IP|hostname>"
                ensure_policy
                unblock_client "$3"
                ;;

            *)
                die "usage: leenuxctl client {list|status|block|unblock} ..."
                ;;
        esac
        ;;

    domain)
        case "${2:-}" in

            list)
                domain_list
                ;;

            block)
                [[ -n "${3:-}" ]] ||
                    die "usage: leenuxctl domain block <domain>"
                domain_block "$3"
                ;;

            unblock)
                [[ -n "${3:-}" ]] ||
                    die "usage: leenuxctl domain unblock <domain>"
                domain_unblock "$3"
                ;;

            clear)
                domain_clear
                ;;

            status)
                domain_status
                ;;

            *)
                die "usage: leenuxctl domain {list|block|unblock|clear|status}"
                ;;
        esac
        ;;

    dns-test)
        [[ -n "${2:-}" ]] ||
            die "usage: leenuxctl dns-test <domain>"
        dns_test "$2"
        ;;

    category)
        case "${2:-}" in
            list)
                category_list
                ;;
            status)
                category_status
                ;;
            show)
                [[ -n "${3:-}" ]] ||
                    die "usage: leenuxctl category show <category>"
                category_show "$3"
                ;;
            enable)
                [[ -n "${3:-}" ]] ||
                    die "usage: leenuxctl category enable <category>"
                category_enable "$3"
                ;;
            disable)
                [[ -n "${3:-}" ]] ||
                    die "usage: leenuxctl category disable <category>"
                category_disable "$3"
                ;;
            *)
                die "usage: leenuxctl category {list|status|show|enable|disable} ..."
                ;;
        esac
        ;;

    policy)
        case "${2:-}" in
            show)
                policy_show
                ;;
            *)
                die "usage: leenuxctl policy show"
                ;;
        esac
        ;;

    help|-h|--help)
        usage
        ;;

    *)
        usage
        exit 1
        ;;

esac
