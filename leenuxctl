# ------------------------------------------------------------
# Router modes
# ------------------------------------------------------------

delete_rule_matching() {
    local needle="$1"
    local handle

    while nft -a list chain ip "$POLICY_TABLE" "$POLICY_CHAIN" 2>/dev/null |
        grep -Fq "$needle"
    do
        handle="$(
            nft -a list chain ip "$POLICY_TABLE" "$POLICY_CHAIN" |
                awk -v a="$needle" '
                    index($0,a) {
                        for(i=1;i<=NF;i++)
                            if($i=="handle")
                                print $(i+1)
                    }' |
                head -n1
        )"

        [[ -n "$handle" ]] || break

        nft delete rule ip "$POLICY_TABLE" "$POLICY_CHAIN" \
            handle "$handle"
    done
}

mode_router() {
    ensure_hotspot
    enable_forwarding
    ensure_policy

    delete_rule_matching \
        "iifname \"$HOTSPOT_IF\" oifname \"$UPSTREAM_IF\" drop"

    delete_rule_matching \
        "iifname \"$UPSTREAM_IF\" oifname \"$HOTSPOT_IF\" drop"

    echo "Mode: router"
}

mode_lan_only() {
    ensure_hotspot
    enable_forwarding
    ensure_policy

    if ! nft -a list chain ip "$POLICY_TABLE" "$POLICY_CHAIN" |
        grep -Fq "iifname \"$HOTSPOT_IF\" oifname \"$UPSTREAM_IF\" drop"
    then
        nft add rule ip "$POLICY_TABLE" "$POLICY_CHAIN" \
            iifname "$HOTSPOT_IF" oifname "$UPSTREAM_IF" drop
    fi

    if ! nft -a list chain ip "$POLICY_TABLE" "$POLICY_CHAIN" |
        grep -Fq "iifname \"$UPSTREAM_IF\" oifname \"$HOTSPOT_IF\" drop"
    then
        nft add rule ip "$POLICY_TABLE" "$POLICY_CHAIN" \
            iifname "$UPSTREAM_IF" oifname "$HOTSPOT_IF" drop
    fi

    echo "Mode: lan-only"
}

mode_disabled() {
    stop_hotspot
    disable_forwarding

    echo "Mode: disabled"
}

uninstall_hotspot() {
    local remove_leenux=0

    case "${1:-}" in
        "")
            ;;
        --removeLeenux)
            remove_leenux=1
            ;;
        *)
            die "usage: leenuxctl uninstall [--removeLeenux]"
            ;;
    esac

    echo
    echo "LeenuxSpot Uninstall"
    echo "===================="
    echo

    # Stop block-page service
    if systemctl is-active --quiet leenux-blockpage.service 2>/dev/null; then
        echo "Stopping block-page service..."
        systemctl stop leenux-blockpage.service || true
    fi

    if systemctl is-enabled --quiet leenux-blockpage.service 2>/dev/null; then
        echo "Disabling block-page service..."
        systemctl disable leenux-blockpage.service >/dev/null 2>&1 || true
    fi

    rm -f "$BLOCKPAGE_SERVICE"
    systemctl daemon-reload

    # Remove hotspot connection
    if hotspot_exists; then
        echo "Removing NetworkManager hotspot..."
        nmcli connection down "$HOTSPOT_CONN" >/dev/null 2>&1 || true
        nmcli connection delete "$HOTSPOT_CONN" >/dev/null 2>&1 || true
    else
        echo "NetworkManager hotspot connection not found."
    fi

    # Remove generated DNS configuration
    if [[ -f "$DNSMASQ_DOMAIN_FILE" ]]; then
        echo "Removing generated DNS configuration..."
        rm -f "$DNSMASQ_DOMAIN_FILE"
    fi

    # Remove nftables policy
    if nft_table_exists; then
        echo "Removing Leenux nftables policy..."
        nft delete table ip "$POLICY_TABLE" >/dev/null 2>&1 || true
    fi

    # Disable forwarding
    if forwarding_enabled; then
        echo "Disabling IPv4 forwarding..."
        disable_forwarding
    fi

    # Remove block-page program
    if [[ -f "$BLOCKPAGE_SCRIPT" ]]; then
        echo "Removing block-page program..."
        rm -f "$BLOCKPAGE_SCRIPT"
    fi

    # Remove Leenux configuration
    if [[ -d "$CONFIG_DIR" ]]; then
        echo "Removing Leenux configuration..."
        rm -rf "$CONFIG_DIR"
    fi

    if (( remove_leenux )); then
        echo
        echo "Removing leenuxctl..."

        rm -f "$TARGET"

        echo
        echo "LeenuxSpot has been completely removed."
        echo "Your backup files were preserved."
    else
        echo
        echo "LeenuxSpot has been uninstalled."
        echo "leenuxctl was kept installed."
        echo
        echo "To remove it completely:"
        echo
        echo "  sudo leenuxctl uninstall --removeLeenux"
    fi

    echo
}

