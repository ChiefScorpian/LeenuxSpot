# ------------------------------------------------------------

status() {
    echo
    echo "LeenuxSpot Router"
    echo "================="
    echo

    echo "System"
    echo "  Version:            $VERSION"
    echo "  Kernel:             $(uname -r)"

    if systemctl is-active --quiet NetworkManager; then
        echo "  NetworkManager:     active"
    else
        echo "  NetworkManager:     inactive"
    fi

    if nft list tables >/dev/null 2>&1; then
        echo "  nftables:           available"
    else
        echo "  nftables:           unavailable"
    fi

    if forwarding_enabled; then
        echo "  IPv4 forwarding:    enabled"
    else
        echo "  IPv4 forwarding:    disabled"
    fi

    echo

    echo "Upstream"

    local upstream_conn upstream_addr upstream_gw

    upstream_conn="$(
        nmcli -t -f GENERAL.CONNECTION device show "$UPSTREAM_IF" 2>/dev/null |
            cut -d: -f2-
    )"

    upstream_addr="$(
        nmcli -g IP4.ADDRESS device show "$UPSTREAM_IF" 2>/dev/null |
            head -n1
    )"

    upstream_gw="$(
        nmcli -g IP4.GATEWAY device show "$UPSTREAM_IF" 2>/dev/null |
            head -n1
    )"

    echo "  Interface:          $UPSTREAM_IF"
    echo "  Connection:         ${upstream_conn:---}"
    echo "  Address:            ${upstream_addr:---}"
    echo "  Gateway:            ${upstream_gw:---}"

    echo

    echo "Hotspot"

    echo "  Interface:          $HOTSPOT_IF"

    if hotspot_active; then
        echo "  State:              connected"
    else
        echo "  State:              inactive"
    fi

    local ssid

    ssid="$(
        nmcli -g 802-11-wireless.ssid connection show "$HOTSPOT_CONN" 2>/dev/null |
            head -n1
    )"

    echo "  SSID:               ${ssid:---}"

    local hotspot_addr

    hotspot_addr="$(
        nmcli -g IP4.ADDRESS device show "$HOTSPOT_IF" 2>/dev/null |
            head -n1
    )"

    echo "  Address:            ${hotspot_addr:---}"

    echo

    echo "Routing"

    echo "  IPv4 forwarding:    $(forwarding_enabled && echo enabled || echo disabled)"

    if nft list table ip nm-shared-wlan1 >/dev/null 2>&1; then
        echo "  NetworkManager NAT: present"
    else
        echo "  NetworkManager NAT: missing"
    fi

    echo

    echo "Internet Sharing"

    if nft -a list chain ip "$POLICY_TABLE" "$POLICY_CHAIN" 2>/dev/null |
        grep -Fq "iifname \"$HOTSPOT_IF\" oifname \"$UPSTREAM_IF\" drop"
    then
        echo "  Status:             OFF (LAN-only)"
    else
        echo "  Status:             ON"
    fi

    echo

    echo "Client Policy"

    local blocked_count=0

    if nft list set ip "$POLICY_TABLE" "$BLOCKED_SET" >/dev/null 2>&1; then
        blocked_count="$(
            nft -a list set ip "$POLICY_TABLE" "$BLOCKED_SET" |
                grep -oE '[0-9a-f]{2}(:[0-9a-f]{2}){5}' |
                wc -l
        )"
    fi

    echo "  Blocked clients:    $blocked_count"

    echo

    echo "DNS Blocking"

    local domain_count=0

    if [[ -f "$DOMAIN_FILE" ]]; then
        domain_count="$(
            grep -v '^[[:space:]]*$' "$DOMAIN_FILE" 2>/dev/null |
            grep -v '^#' 2>/dev/null |
            wc -l
        )"
    fi

    echo "  Blocked domains:    $domain_count"
    echo "  DNS config:         $DNSMASQ_DOMAIN_FILE"

    if dnsmasq_running; then
        echo "  dnsmasq:            running"
    else
        echo "  dnsmasq:            not detected"
    fi

    if systemctl is-active --quiet leenux-blockpage.service 2>/dev/null; then
        echo "  Block page:         active"
    else
        echo "  Block page:         inactive"
    fi

    echo

    echo "Clients"

    local lease_count=0

    if [[ -f "$LEASE_FILE" ]]; then
        lease_count="$(wc -l < "$LEASE_FILE")"
    fi

    echo "  DHCP leases:        $lease_count"

    echo
}

# ------------------------------------------------------------
# Doctor
# ------------------------------------------------------------

doctor() {
    local failures=0

    echo
    echo "LeenuxSpot Doctor"
    echo "================="
    echo

    if systemctl is-active --quiet NetworkManager; then
        echo "  ✓ NetworkManager is running"
    else
        echo "  ✗ NetworkManager is not running"
        failures=$((failures + 1))
    fi

    if ip link show "$UPSTREAM_IF" >/dev/null 2>&1; then
        echo "  ✓ $UPSTREAM_IF exists"
    else
        echo "  ✗ $UPSTREAM_IF missing"
        failures=$((failures + 1))
    fi

    if ip link show "$HOTSPOT_IF" >/dev/null 2>&1; then
        echo "  ✓ $HOTSPOT_IF exists"
    else
        echo "  ✗ $HOTSPOT_IF missing"
        failures=$((failures + 1))
    fi

    if forwarding_enabled; then
        echo "  ✓ IPv4 forwarding enabled"
    else
        echo "  ✗ IPv4 forwarding disabled"
        failures=$((failures + 1))
    fi

    if hotspot_exists; then
        echo "  ✓ LeenuxSpot profile exists"
    else
        echo "  ✗ LeenuxSpot profile missing"
        failures=$((failures + 1))
    fi

    if nft list tables >/dev/null 2>&1; then
        echo "  ✓ nftables is functional"
    else
        echo "  ✗ nftables is not functional"
        failures=$((failures + 1))
    fi

    if nft list table ip nm-shared-wlan1 >/dev/null 2>&1; then
        echo "  ✓ NetworkManager NAT exists"
    else
        echo "  ✗ NetworkManager NAT missing"
        failures=$((failures + 1))
    fi

    ensure_policy

    echo "  ✓ Leenux policy table exists"
    echo "  ✓ Blocked-client set exists"
    echo "  ✓ Leenux forward chain exists"

    if nft -a list chain ip "$POLICY_TABLE" "$POLICY_CHAIN" 2>/dev/null |
        grep -Fq "iifname \"$HOTSPOT_IF\" ether saddr @$BLOCKED_SET drop"
    then
        echo "  ✓ Client blocking rule exists"
    else
        echo "  ✗ Client blocking rule missing"
        failures=$((failures + 1))
    fi

    ensure_domain_files

    if [[ -f "$DNSMASQ_DOMAIN_FILE" ]]; then
        echo "  ✓ DNS blocking configuration exists"
    else
        echo "  ✗ DNS blocking configuration missing"
        failures=$((failures + 1))
    fi

    if grep -Fq "address=/" "$DNSMASQ_DOMAIN_FILE" 2>/dev/null; then
        echo "  ✓ DNS A-record blocking configured"
    else
        echo "  ! No blocked-domain A-records configured"
    fi

    if systemctl is-active --quiet leenux-blockpage.service 2>/dev/null; then
        echo "  ✓ Block page service running"
    else
        echo "  ✗ Block page service not running"
        failures=$((failures + 1))
    fi

    echo

    if (( failures == 0 )); then
        echo "✓ No problems detected."
        return 0
    fi

    echo "✗ $failures problem(s) detected."
    return 1
}

